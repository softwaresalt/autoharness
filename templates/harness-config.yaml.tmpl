# autoharness Configuration
#
# Resolved harness configuration for this workspace.
# Written by autoharness install; updated by autoharness tune.
# Operator edits to this file are preserved on re-install and tuning.
#
# Schema: schemas/harness-config.schema.json

schema_version: "1.1.0"

# Installation preset: starter | standard | full
preset: {{INSTALL_PRESET}}

# Additive stack classification used for composition
primary_stack_pack: {{PRIMARY_STACK_PACK}}
stack_packs: {{STACK_PACKS_YAML}}

# Explicit artifact-class layers selected for installation
install_layers: {{INSTALL_LAYERS_YAML}}

# Capability packs enabled for this workspace
capability_packs: {{CAPABILITY_PACKS_YAML}}

# Backlog tool configuration
backlog:
  tool: {{BACKLOG_TOOL_NAME}}
  directory: {{BACKLOG_DIRECTORY}}
  suffix_map:
    feature: "{{SUFFIX_FEATURE}}"
    chore: "{{SUFFIX_CHORE}}"
    task: "{{SUFFIX_TASK}}"
    spike: "{{SUFFIX_SPIKE}}"
    deliberation: "{{SUFFIX_DELIBERATION}}"
    bug: "{{SUFFIX_BUG}}"
    epic: "{{SUFFIX_EPIC}}"
    subtask: "{{SUFFIX_SUBTASK}}"
    shipment: "{{SUFFIX_SHIPMENT}}"

# Long-lived knowledge artifact directories
docs:
  root: {{DOCS_ROOT}}
  subdirectories:
    compound: {{DOCS_COMPOUND_DIR}}
    plans: {{DOCS_PLANS_DIR}}
    decisions: {{DOCS_DECISIONS_DIR}}
    memory: {{DOCS_MEMORY_DIR}}
    closure: {{DOCS_CLOSURE_DIR}}
    design_docs: {{DOCS_DESIGN_DOCS_DIR}}
    product_specs: {{DOCS_PRODUCT_SPECS_DIR}}

# Optional continuous-learning capability-pack configuration
continuous_learning:
  directory: "{{CONTINUOUS_LEARNING_DIR}}"
  capture_hooks: {{CONTINUOUS_LEARNING_CAPTURE_HOOKS}}
  environment_adapter: "{{CONTINUOUS_LEARNING_ENVIRONMENT_ADAPTER}}"
  promotion_threshold: {{CONTINUOUS_LEARNING_PROMOTION_THRESHOLD}}

# Optional strict-safety capability-pack configuration
strict_safety:
  enabled: {{STRICT_SAFETY_ENABLED}}
  require_approval_for:
    - destructive

# Model routing preferences (map tiers to model identifiers and per-tier config)
model_routing:
  tier1:
    model: {{MODEL_ROUTING_TIER1}}              # Fast/cheap: memory, docs, compaction (e.g., gpt-5.4-mini)
    reasoning_effort: "{{TIER_1_REASONING_EFFORT}}"  # Leave empty to use model default
    model_provider: "{{TIER_1_PROVIDER}}"       # e.g., openai, anthropic — leave empty for default
    model_family: "{{TIER_1_FAMILY}}"           # Resolved into Tier 1 agent frontmatter
  tier2:
    model: {{MODEL_ROUTING_TIER2}}              # Standard: orchestration, code, review (e.g., claude-sonnet-5)
    reasoning_effort: "{{TIER_2_REASONING_EFFORT}}"
    model_provider: "{{TIER_2_PROVIDER}}"
    model_family: "{{TIER_2_FAMILY}}"
  tier3:
    model: {{MODEL_ROUTING_TIER3}}              # Frontier: planning, architecture, analysis (e.g., claude-opus-5)
    reasoning_effort: "{{TIER_3_REASONING_EFFORT}}"
    model_provider: "{{TIER_3_PROVIDER}}"
    model_family: "{{TIER_3_FAMILY}}"
  orchestrator:
    model_family: "{{ORCHESTRATOR_FAMILY}}"     # Orchestrator model override (default: gpt-5.4)
    reasoning_effort: "{{ORCHESTRATOR_REASONING_EFFORT}}"
    model_provider: "{{ORCHESTRATOR_PROVIDER}}"
  # P-013.5: optional role routes for Stage/Ship invocation-time model routing.
  # Absent/empty sub-fields fall back to tier3 (stage) / tier2 (ship) — do not
  # remove this block to "disable" routing; leave sub-fields empty instead.
  stage:
    model_family: "{{STAGE_FAMILY}}"             # Stage role route (falls back to tier3 when empty)
    model_provider: "{{STAGE_PROVIDER}}"
    reasoning_effort: "{{STAGE_REASONING_EFFORT}}"
    # F02FD596: optional nested per-role escalation override for Stage.
    # Takes precedence over the legacy flat model_routing.escalation below;
    # missing sub-fields fall back per-field to tier3 (never to the legacy
    # flat route). MUST NOT be declared alongside a non-empty legacy flat
    # escalation (both-present is AMBIGUOUS and fails closed, H2). Always
    # rendered (like the flat escalation block below) so Step 3.4 can
    # preserve an existing operator value through re-render/tune; leave
    # sub-fields empty to omit this override.
    escalation:
      model_family: "{{STAGE_ESCALATION_FAMILY}}"
      model_provider: "{{STAGE_ESCALATION_PROVIDER}}"
      reasoning_effort: "{{STAGE_ESCALATION_REASONING_EFFORT}}"
  ship:
    model_family: "{{SHIP_FAMILY}}"               # Ship role route (falls back to tier2 when empty)
    model_provider: "{{SHIP_PROVIDER}}"
    reasoning_effort: "{{SHIP_REASONING_EFFORT}}"
    # F02FD596: optional nested per-role escalation override for Ship. Same
    # precedence/ambiguity/always-rendered rules as Stage's nested
    # escalation above.
    escalation:
      model_family: "{{SHIP_ESCALATION_FAMILY}}"
      model_provider: "{{SHIP_ESCALATION_PROVIDER}}"
      reasoning_effort: "{{SHIP_ESCALATION_REASONING_EFFORT}}"
  # P-013.6: optional escalation route for telemetry-driven auto-escalation.
  # Absent/empty sub-fields fall back per-field to tier3. If the resolved
  # route equals a declared role route's resolved route, that is
  # ESCALATION_DEGRADED (same-route no-op) -- declare a distinct family here
  # to keep genuine escalation available; do not remove this block to
  # "disable" escalation, leave sub-fields empty instead.
  # F02FD596 -- DEPRECATED-LEGACY: prefer nested per-role escalation
  # (stage.escalation / ship.escalation above) instead of this flat,
  # role-agnostic block. Retained for backward compatibility (H9); MUST NOT
  # coexist with any nested <role>.escalation override -- both-present is
  # AMBIGUOUS and fails closed (H2). Migrate fully to nested per-role
  # escalation, or remove the nested override(s), before declaring both.
  escalation:
    model_family: "{{LEGACY_ESCALATION_FAMILY}}"          # Escalation route (falls back to tier3 when empty)
    model_provider: "{{LEGACY_ESCALATION_PROVIDER}}"
    reasoning_effort: "{{LEGACY_ESCALATION_REASONING_EFFORT}}"
  anchor_review:
    model_provider: "{{ANCHOR_REVIEW_PROVIDER}}"       # Anchor reviewer provider (default: openai)
    model_family: "{{ANCHOR_REVIEW_FAMILY}}"           # Anchor reviewer family (default: gpt-5.6-sol)
    reasoning_effort: "{{ANCHOR_REVIEW_REASONING_EFFORT}}"  # Leave empty to use model default

# AI CLI tool startup configuration
# Resolves {{COPILOT_EXE_PATH}} in the generated start.ps1 and start.sh scripts,
# and is read directly by `autoharness run`. Set exe_path to the full path if
# copilot is not on PATH. Use args for flags that should always be passed, e.g.
# ["--remote"].
ai_tools:
  copilot_cli:
    exe_path: "{{COPILOT_EXE_PATH}}"  # Default: "copilot" (expects it on PATH)
                                      # Example: "C:\\Tools\\ghcpcli\\copilot.exe"
    args: {{COPILOT_CLI_ARGS_YAML}}  # Default: []

# Sidecar syncs `autoharness run` performs before launching the AI CLI tool.
# Derived at merge-install time from the capability packs enabled for this
# workspace. Omit this key to run every known sidecar (backward-compatible
# default).
sidecars: {{ENABLED_SIDECARS_YAML}}

# Optional browser-automation capability configuration (used when browser-verification is enabled)
browser:
  cli: "{{BROWSER_CLI}}"                    # Default: "agent-browser"
  headless_flag: "{{BROWSER_HEADLESS_FLAG}}" # Default: "--headless"

# Optional iterative-experiment skill configuration
experiments:
  branch_prefix: "{{EXPERIMENT_BRANCH_PREFIX}}"  # Default: "experiment/"
  results_dir: "{{EXPERIMENT_RESULTS_DIR}}"       # Default: "docs/experiments"

# Explicit template variable overrides applied during install/tune (use sparingly —
# prefer fixing the workspace setup over overriding discovery results)
overrides: {{HARNESS_OVERRIDES_YAML}}

# ---------------------------------------------------------------------------
# Optional: Deterministic validation gates (lifecycle_hooks + telemetry)
# ---------------------------------------------------------------------------
# The ENTIRE lifecycle_hooks block is OPTIONAL and disabled by default.
# When absent, no gates run and behavior is identical to an install without
# gates (fail-open-to-current). Validated against
# schemas/validation-gates/1.0.0.schema.json. See docs/gates-reference.md.
#
# KILL-SWITCH: remove or empty this block to disable all gating with zero code
# change.
#
# Uncomment and adapt to enable. Only the closed placeholder vocabulary
# {file_path}, {task_id}, {result} is permitted in command/write_back strings.
#
# lifecycle_hooks:
#   pre_execution:
#     - name: "estimate_complexity"
#       condition: "task.size == null"
#       action: "internal:estimate_tshirt_size"
#       write_back: "backlogit update {task_id} --size {result}"
#   pre_task_completion:
#     enforcement: "absolute"          # absolute | advisory (default absolute)
#     on_repeated_failure: "block"     # block | escalate  (default block)
#     max_gate_failures: 3             # aligns circuit-breaker threshold
#     validation_gates:
#       - pattern: "docs/**/*.md"
#         command: "engram verify {file_path}"
#         timeout_seconds: 15
#       - pattern: ".backlogit/queue/*.md"
#         command: "backlogit doctor --target {file_path}"
#         timeout_seconds: 5
#       - pattern: "src/**/*.py"
#         command: "pytest tests/ --lf"
#         timeout_seconds: 60
#
# telemetry:                           # Phase 2 sink — repo-local Execution Epochs
#   mode: "sqlite"                     # sqlite | none (default none = kill-switch)
#   database_path: ".autoharness/metrics/execution_epochs.db"
#   emit_jsonl: true                   # append one JSON epoch per line (emit-only)
#
# ACTIVATION: set mode: "sqlite" to record execution epochs to the repo-local
# SQLite aggregator at database_path (parent dirs auto-created, WAL journaling).
# Set emit_jsonl: true to also append a JSONL stream alongside the DB for the
# external agent-engram ingestion boundary. The runtime artifacts under
# .autoharness/metrics/ are gitignored so emission never dirties the tree.
# KILL-SWITCH: mode: "none" (or removing this block) disables all telemetry with
# zero code change (fail-open-to-current). See docs/telemetry-reference.md.
