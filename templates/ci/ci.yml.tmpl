# Generated by autoharness | Template: ci/ci.yml.tmpl
#
# Language-agnostic CI workflow implementing the unified CI + local-gating
# primitive (P-019). Four-job shape:
#   1. changes           — lightweight, ALWAYS runs, fail-closed path detection.
#   2. {{CI_EXPENSIVE_JOB_NAME}} — the expensive test/build gate; runs only when
#                          the fail-closed `changes` job detected a code change.
#   3. topology-check     — always-running pipeline-topology CI backstop (Gate
#                          C, P-001/P-016), required-vs-advisory via the
#                          `PIPELINE_TOPOLOGY_GATE_REQUIRED` repository variable.
#   4. {{CI_REQUIRED_CHECK_NAME}} — the always-running aggregation gate. This is
#                          the ONLY job a branch ruleset should require: it treats
#                          a skipped expensive job as OK and fails only when a
#                          needed job actually failed or was cancelled.
#
# Regular PR/push CI is Linux-only ({{CI_RUNNER_OS}}); cross-OS verification is
# deferred to release-tag workflows. To run every PR across macOS/Windows,
# replace `runs-on: {{CI_RUNNER_OS}}` with a matrix strategy (see the OS-matrix
# escape hatch documented in templates/ci/README.md).
#
# Actions are SHA-pinned. Refreshing pins is a periodic maintenance chore, not a
# per-change concern.
name: CI

on:
  push:
    branches:
      - {{CI_DEFAULT_BRANCH}}
  pull_request:
    branches:
      - {{CI_DEFAULT_BRANCH}}

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # Lightweight always-running gate: decide whether the expensive pipeline needs
  # to run. Because this job always runs, a status is always reported while the
  # costly job below is skipped for changes that touch only docs/backlog files.
  #
  # predicate-quantifier: 'every' requires ALL patterns to match per file, so the
  # '!' negations actually exclude docs/markdown/backlog. Under the default 'some'
  # the leading '**' alone would mark every file matched and the negations would
  # never take effect (see dorny/paths-filter README) — a fail-OPEN bug. 'every'
  # makes any code/config/unknown-type change fail CLOSED into the expensive gate.
  changes:
    name: detect code changes
    runs-on: {{CI_RUNNER_OS}}
    permissions:
      contents: read
      pull-requests: read
    outputs:
      code: ${{ steps.filter.outputs.code }}
    steps:
      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
      - name: Detect code changes
        id: filter
        uses: dorny/paths-filter@d1c1ffe0248fe513906c8e24db8ea791d46f8590 # v3.0.3
        with:
          predicate-quantifier: 'every'
          filters: |
            # Denylist: match any changed file that is NOT pure docs/backlog
            # state, so a code/config change can never silently skip the gate.
            code:
              - '**'
{{CI_DOCS_ONLY_PATHS}}

  # Expensive test/build gate. Runs only when the fail-closed `changes` job
  # detected a code/config change. Execution is gated SOLELY on the path result
  # so a code change can never bypass validation via the PR title — a `docs:` or
  # `chore:` title cannot skip the tests when code actually changed. Docs/backlog
  # -only PRs skip this job because `changes` reports `code == 'false'`.
  #
  # The job ID (`expensive`) is a fixed, valid GitHub Actions identifier; the
  # human-facing check context is `name: {{CI_EXPENSIVE_JOB_NAME}}`, which may
  # contain spaces/slashes. Job IDs may not, so the two are decoupled.
  expensive:
    name: {{CI_EXPENSIVE_JOB_NAME}}
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: {{CI_RUNNER_OS}}
    steps:
{{CI_SETUP_STEPS}}
      - name: Lint
        run: {{LINT_COMMAND}}
      - name: Format check
        run: {{FORMAT_CHECK_COMMAND}}
      - name: Typecheck
        run: {{TYPECHECK_COMMAND}}
      - name: Test
        run: {{TEST_COMMAND}}
      - name: Build check
        run: {{BUILD_CHECK_COMMAND}}

  # Pipeline-topology CI backstop (Gate C, 109.014-T): the server-side
  # re-validation of the P-001 (at-most-one-active-shipment) / P-016 (single
  # implementation worktree/branch) invariants. Local hooks
  # (pre-commit-pipeline-topology.*, pre-push-quality-gates.*) are always
  # skippable via `git ... --no-verify`, and Git has no pre-worktree-add hook
  # at all -- CI closes that gap once a checkout syncs.
  #
  # THREAT MODEL / LIMITS: this job is NOT a non-bypassable backstop against a
  # malicious or compromised PR. GitHub's `pull_request` trigger (by design,
  # for contributor ergonomics) loads and runs THIS WORKFLOW FILE ITSELF from
  # the proposed PR head, so the same PR that violates topology invariants
  # can also edit this job (or ci-gate's needs/results aggregation below) to
  # trivially report success. What it DOES provide: a catch for
  # accidental/careless local bypasses that were never intended to touch the
  # enforcement workflow, and an ambient, non-shipment-scoped signal on every
  # push/PR from contributors who don't touch `.github/workflows/` or
  # `scripts/ci-topology-check.sh`. See "Threat Model & CODEOWNERS Hardening"
  # in docs/pipeline-topology-gate-ci-rollout.md for the recommended
  # mitigation (CODEOWNERS-required review on the enforcement surface) and a
  # stronger, out-of-scope alternative (`pull_request_target`).
  #
  # Always runs -- unlike `expensive`, this job is NOT gated on the `changes`
  # path-filter output: the ambient invocation is inexpensive and
  # non-shipment-scoped, and skipping it for docs/backlog-only changes would
  # leave exactly the commits most likely to touch `.backlog/` state (or legacy
  # `.backlogit/` state; both-roots-present must fail closed)
  # unchecked.
  #
  # REQUIRED-VS-ADVISORY is an explicit OPERATOR TOGGLE via the
  # `PIPELINE_TOPOLOGY_GATE_REQUIRED` repository variable: unset (default)
  # means advisory -- `continue-on-error: true` keeps this job's reported
  # result `success` for dependents (including `ci-gate` below) even when the
  # gate itself reports BLOCK. Setting the variable to `'true'` flips
  # `continue-on-error` to `false`, making a BLOCK verdict fail this job (and
  # therefore `ci-gate`) for real -- with NO WORKFLOW RE-RENDER NEEDED. See
  # docs/pipeline-topology-gate.md and docs/pipeline-topology-gate-ci-rollout.md
  # for the staged advisory->required rollout.
  topology-check:
    name: pipeline-topology (ambient)
    runs-on: {{CI_RUNNER_OS}}
    continue-on-error: ${{ vars.PIPELINE_TOPOLOGY_GATE_REQUIRED != 'true' }}
    steps:
      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0
        with:
          python-version: '3.12'
      - name: Install autoharness
        run: {{CI_AUTOHARNESS_INSTALL_COMMAND}}
      - name: Run CI topology-check entrypoint
        run: bash scripts/ci-topology-check.sh

  # Always-reporting aggregation gate. REQUIRE THIS job in branch protection
  # instead of the guarded expensive job: when the expensive job is skipped for a
  # docs-only PR, GitHub reports it "skipped" — which a required
  # check treats as not-successful and would block the merge. This gate always
  # runs and passes unless a needed job actually failed or was cancelled.
  #
  # The job ID (`ci-gate`) is a fixed, valid GitHub Actions identifier. The
  # required-check context that a branch ruleset matches on is the reported
  # `name: {{CI_REQUIRED_CHECK_NAME}}`, which may contain spaces (e.g. `ci gate`)
  # — set {{CI_REQUIRED_CHECK_NAME}} to the exact name the ruleset already
  # requires so no ruleset edit is needed.
  ci-gate:
    name: {{CI_REQUIRED_CHECK_NAME}}
    if: always()
    needs: [changes, expensive, topology-check]
    runs-on: {{CI_RUNNER_OS}}
    steps:
      - name: Verify no required job failed
        run: |
          results="${{ needs.changes.result }} ${{ needs.expensive.result }} ${{ needs['topology-check'].result }}"
          echo "job results: $results"
          for r in $results; do
            if [ "$r" = "failure" ] || [ "$r" = "cancelled" ]; then
              echo "::error::A required job did not succeed: $r"
              exit 1
            fi
          done
          echo "All required jobs passed or were intentionally skipped."
