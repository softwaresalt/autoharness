# Agent CLI Startup Script — {{PROJECT_NAME}}
#
# This script is a thin compatibility shim: it delegates the entire
# supervised Copilot CLI session lifecycle -- workspace bootstrap, sidecar
# preflight, CLI resolution, spawn, and lifecycle supervision -- to
# `autoharness run`. See src/autoharness/supervise/ (bootstrap.py,
# sidecar.py, resolve.py, app.py) for the implementation this script no
# longer duplicates.
#
# This script does NOT install or refresh Auto-MergeInstall / Auto-Tune.
# Those are GLOBAL agents provided by the autoharness marketplace plugin --
# the versions used when upgrading autoharness -- and are intentionally NOT
# copied into this workspace's local agent config, where a stale copy would
# shadow the global agent during an upgrade. Upgrade them globally with
# `copilot plugin install autoharness@autoharness`.
#
# Generated by autoharness. Re-run install or tune to regenerate.

# ai_tools.copilot_cli.exe_path from .autoharness/config.yaml, when
# explicitly configured to something other than a bare PATH lookup, is
# forwarded as an environment default so `autoharness run`'s own CLI
# resolution (COPILOT_EXE_PATH env -> COPILOT_EXE env -> PATH lookup) picks
# it up at the same precedence tier the operator's own environment would.
if (-not $env:COPILOT_EXE_PATH -and -not $env:COPILOT_EXE) {
    $defaultCopilotExe = "{{COPILOT_EXE_PATH}}"
    if ($defaultCopilotExe -and ($defaultCopilotExe -ne "copilot")) {
        $env:COPILOT_EXE_PATH = $defaultCopilotExe
    }
}

autoharness run --workspace $PSScriptRoot -- @args
exit $LASTEXITCODE

