{
  "mcpServers": {
    "backlogit": {
      "type": "stdio",
      "command": "backlogit",
      "args": ["mcp"],
      "tools": ["*"]
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": ["shim"],
      "tools": ["*"]
    },
    "graphtor-docs": {
      "type": "stdio",
      "command": "bun",
      "args": ["scripts/graphtor-mcp-shim.cjs", "graphtor-docs", "serve", "--read-only"],
      "x-graphtor-managed": true,
      "tools": ["*"]
    },
    "context7": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@upstash/context7-mcp"],
      "tools": ["*"]
    },
    "tavily": {
      "type": "stdio",
      "command": "bunx",
      "args": ["tavily-mcp"],
      "tools": ["*"]
    },
    "github": {
      "type": "stdio",
      "command": "github-mcp-server.exe",
      "args": ["stdio"],
      "tools": ["*"]
    }
  }
}
