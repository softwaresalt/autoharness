  "$id": "https://github.com/softwaresalt/autoharness/schemas/harness-resolution/1.0.0.schema.json",
  "title": "HarnessResolution",
  "description": "harness-resolution 1.0.0: the result of one shipment harness-surface resolution (docs/plans/2026-09-25-ship-lifecycle-release-units-plan.md, Unit B). Field set of the proven Proof C run 4 fixture schema (FI-7) with declarations as ratified (FI-6 item d). One oneOf branch per reason code binds its state, exit code, surface row and diagnostics. A class 1b read-limit result carries exactly its native read_error_code and one read_stage diagnostic; no other result carries either. shipment_id is null only when the requested ID is syntactically invalid; backlog_root is null only for the two backlog-root codes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "reason_code",
    "exit_code",
    "shipment_id",
    "backlog_root",
    "surfaces",
    "declarations",
    "inputs_sha256",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "state": {
      "enum": [
        "HARNESS_READY",
        "NO_HARNESS",
        "UNRESOLVED"
      ]
    },
    "reason_code": {
      "enum": [
        "INPUT_CHANGED_DURING_RESOLUTION",
        "FILE_COUNT_LIMIT",
        "TOTAL_SIZE_LIMIT",
        "FILE_SIZE_LIMIT",
        "BACKLOG_ROOT_NOT_FOUND",
        "BACKLOG_ROOT_AMBIGUOUS",
        "SHIPMENT_ID_INVALID",
        "SHIPMENT_NOT_FOUND",
        "SHIPMENT_AMBIGUOUS",
        "SHIPMENT_RECORD_INVALID",
        "SHIPMENT_ID_MISMATCH",
        "MEMBERS_INVALID",
        "MEMBERS_EMPTY",
        "MEMBERS_TOO_MANY",
        "MEMBER_ID_INVALID",
        "MEMBER_KIND_UNSUPPORTED",
        "MEMBER_DUPLICATE",
        "MEMBER_NOT_FOUND",
        "MEMBER_AMBIGUOUS",
        "MEMBER_RECORD_INVALID",
        "MEMBER_ID_MISMATCH",
        "NO_TASK_MEMBERS",
        "FEATURE_DECLARES_SURFACE",
        "DECLARATION_MISSING",
        "DECLARATION_MALFORMED",
        "DECLARATION_DUPLICATE",
        "DECLARATION_MIXED",
        "SURFACE_UNSUPPORTED",
        "NO_SURFACES_REQUIRED",
        "MANIFEST_NOT_FOUND",
        "MANIFEST_UNREADABLE",
        "MANIFEST_DECODE_INVALID",
        "MANIFEST_YAML_INVALID",
        "MANIFEST_DUPLICATE_KEY",
        "MANIFEST_SHAPE_INVALID",
        "MANIFEST_ENTRY_AMBIGUOUS",
        "MANIFEST_TEMPLATE_MISMATCH",
        "MANIFEST_ENTRY_INVALID",
        "TEMPLATE_NOT_FOUND",
        "TEMPLATE_UNREADABLE",
        "TEMPLATE_VARIABLE_UNRESOLVED",
        "INSTALLED_UNREADABLE",
        "MANIFEST_ENTRY_NOT_FOUND",
        "INSTALLED_NOT_FOUND",
        "CHECKSUM_MISMATCH",
        "RENDER_MISMATCH",
        "ALL_SURFACES_PRESENT"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "shipment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+-S$"
    },
    "backlog_root": {
      "enum": [
        ".backlog",
        ".backlogit",
        null
      ]
    },
    "surfaces": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "installed_path",
          "template",
          "state",
          "reason_code"
        ],
        "properties": {
          "surface_id": {
            "enum": [
              "harness-architect"
            ]
          },
          "installed_path": {
            "enum": [
              ".github/skills/harness-architect/SKILL.md"
            ]
          },
          "template": {
            "enum": [
              "skills/harness-architect/SKILL.md.tmpl"
            ]
          },
          "state": {
            "enum": [
              "PRESENT",
              "MISSING",
              "STALE",
              "INVALID"
            ]
          },
          "reason_code": {
            "enum": [
              "MANIFEST_ENTRY_AMBIGUOUS",
              "MANIFEST_TEMPLATE_MISMATCH",
              "MANIFEST_ENTRY_INVALID",
              "TEMPLATE_NOT_FOUND",
              "TEMPLATE_UNREADABLE",
              "TEMPLATE_VARIABLE_UNRESOLVED",
              "INSTALLED_UNREADABLE",
              "MANIFEST_ENTRY_NOT_FOUND",
              "INSTALLED_NOT_FOUND",
              "CHECKSUM_MISMATCH",
              "RENDER_MISMATCH",
              "ALL_SURFACES_PRESENT"
            ]
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "surface_id"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "surface_id": {
            "type": "string"
          }
        }
      }
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
