        "routes": {"r": {"tier": "tier1", "reasoning_effort": "low", "model_provider": "p-delta"}},
        "bindings": {"agent:x": {"route": "r", "reasoning_effort": "xhigh"}}
      }},
      "expected": {
        "model_family": "fam-t1", "model_provider": "p-delta", "reasoning_effort": "xhigh", "context_tier": "default",
        "tier_class": "tier1", "errors": [],
