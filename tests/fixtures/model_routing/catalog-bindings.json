{
  "schema_version": "1.0.0",
  "description": "Language-neutral vectors for the tier-delta route catalog and subagent site bindings (BF66F08B / 040-DL D2-D4). Each vector resolves one site; `sites` is the registry passed in (never discovered); `branch` is the explicit precedence branch the resolver must take.",
  "vectors": [
    {
      "id": "unbound-inherits-every-field-from-site-default-tier",
      "description": "Contrast case: no binding, so the site default tier (tier2) supplies every field.",
      "branch": "unbound",
      "site": "agent:x",
      "sites": {"x": {"default_tier": "tier2", "managed": true}},
      "config": {"model_routing": {
        "tier1": {"model_family": "fam-t1"},
        "tier2": {"model_family": "fam-t2", "model_provider": "prov-t2", "reasoning_effort": "high", "context_tier": "long_context"},
        "tier3": {"model_family": "fam-t3", "model_provider": "prov-t3", "reasoning_effort": "medium"}
      }},
      "expected": {
        "model_family": "fam-t2", "model_provider": "prov-t2", "reasoning_effort": "high", "context_tier": "long_context",
        "tier_class": "tier2", "errors": [],
        "resolution_chain": ["tier2.model_family", "tier2.model_provider", "tier2.reasoning_effort", "tier2.context_tier"]
      }
    },
    {
      "id": "bound-bare-tier-keeps-unset-fields-empty",
      "description": "Bound to bare tier1 (family only): provider and effort stay empty and context_tier is default; none inherited from the site default tier2.",
      "branch": "bound",
      "site": "agent:x",
      "sites": {"x": {"default_tier": "tier2", "managed": true}},
      "config": {"model_routing": {
        "tier1": {"model_family": "fam-t1"},
        "tier2": {"model_family": "fam-t2", "model_provider": "prov-t2", "reasoning_effort": "high", "context_tier": "long_context"},
        "tier3": {"model_family": "fam-t3", "model_provider": "prov-t3", "reasoning_effort": "medium"},
        "bindings": {"agent:x": {"route": "tier1"}}
      }},
      "expected": {
        "model_family": "fam-t1", "model_provider": "", "reasoning_effort": "", "context_tier": "default",
        "tier_class": "tier1", "errors": [],
        "resolution_chain": ["tier1.model_family", "default.context_tier"]
      }
    },
    {
      "id": "bound-catalog-route-sets-only-effort",
      "description": "Bound to a catalog route (tier1, only reasoning_effort low): provider stays empty, effort is low, context_tier is default.",
      "branch": "bound",
      "site": "agent:x",
      "sites": {"x": {"default_tier": "tier2", "managed": true}},
      "config": {"model_routing": {
        "tier1": {"model_family": "fam-t1"},
        "tier2": {"model_family": "fam-t2", "model_provider": "prov-t2", "reasoning_effort": "high", "context_tier": "long_context"},
        "tier3": {"model_family": "fam-t3", "model_provider": "prov-t3", "reasoning_effort": "medium"},
        "routes": {"lowfx": {"tier": "tier1", "reasoning_effort": "low"}},
        "bindings": {"agent:x": {"route": "lowfx"}}
      }},
      "expected": {
        "model_family": "fam-t1", "model_provider": "", "reasoning_effort": "low", "context_tier": "default",
        "tier_class": "tier1", "errors": [],
        "resolution_chain": ["tier1.model_family", "routes.lowfx.reasoning_effort", "default.context_tier"]
      }
    },
    {
      "id": "bound-context-tier-override-only",
      "description": "Bound to bare tier1 with only a context_tier override: that field comes from the override; the others still do not fall to tier2.",
      "branch": "bound",
      "site": "agent:x",
      "sites": {"x": {"default_tier": "tier2", "managed": true}},
      "config": {"model_routing": {
        "tier1": {"model_family": "fam-t1"},
        "tier2": {"model_family": "fam-t2", "model_provider": "prov-t2", "reasoning_effort": "high", "context_tier": "long_context"},
        "tier3": {"model_family": "fam-t3", "model_provider": "prov-t3", "reasoning_effort": "medium"},
        "bindings": {"agent:x": {"route": "tier1", "context_tier": "long_context"}}
      }},
      "expected": {
        "model_family": "fam-t1", "model_provider": "", "reasoning_effort": "", "context_tier": "long_context",
        "tier_class": "tier1", "errors": [],
        "resolution_chain": ["tier1.model_family", "bindings.agent:x.context_tier"]
      }
    },
    {
      "id": "bound-bare-tier-with-field-overrides",
      "description": "A binding's per-field overrides win over the tier's own values.",
