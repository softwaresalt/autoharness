{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "bash|view|task|.*_mcp.*",
        "command": "python experiments/088-compression-experiment/brainspace/hook_cli.py",
        "timeoutSec": 10,
        "env": {"BRAINSPACE_WORKSPACE": "${workspaceFolder}"}
      }
    ]
  }
}
